# ZincSearch Configuration
# Copy this file to .env and update with your actual values

# ZincSearch server URL (default: http://localhost:4080)
ZINC_URL=http://localhost:4080

# ZincSearch authentication
ZINC_USER=admin
ZINC_PASSWORD=your_password_here

# Legacy Elasticsearch port (kept for backward compatibility)
# Set to use ZincSearch port if migrating
ES_PORT=4080

# Search engine type: 'zincsearch' or 'elasticsearch'
SEARCH_ENGINE=zincsearch
